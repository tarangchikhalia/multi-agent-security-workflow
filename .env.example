# Synthetic local credentials only. Copy to .env; never commit real secrets.
POSTGRES_PASSWORD=bootstrap-local-demo
DOCS_DB_PASSWORD=docs-local-demo
REQUESTS_DB_PASSWORD=requests-local-demo
SERVICE_DB_PASSWORD=backend-local-demo
DOCS_TOKEN=docs-local-token
REQUESTS_TOKEN=requests-local-token
SERVICE_MCP_TOKEN=db-local-token
SERVICE_API_TOKEN=backend-local-token
# Offset these if local ports are occupied. Integration tests read the same values.
POSTGRES_PORT=55432
DOCS_PORT=8001
REQUESTS_PORT=8002
SERVICE_MCP_PORT=8003
SERVICE_API_PORT=8004
# Optional Support agent (docker compose --profile agents up -d --build support_agent).
OPENAI_API_KEY=
OPENAI_MODEL=
SUPPORT_AGENT_PORT=8010
DEBUG_AGENT_PORT=8011
RESOLVER_AGENT_PORT=8012
DOCUMENTATION_AGENT_PORT=8013
